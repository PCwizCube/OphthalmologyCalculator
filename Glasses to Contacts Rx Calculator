<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Glasses to Contacts Conversion Calculator</title>
<style>
  :root {
    --bg: #fbfaf8;
    --panel: #ffffff;
    --ink: #1f2320;
    --muted: #6b7268;
    --line: #dfe3de;
    --accent: #3d5a4c;
    --accent-soft: #e7ede9;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #14161a;
      --panel: #1c1f24;
      --ink: #eceeec;
      --muted: #9aa39c;
      --line: #303530;
      --accent: #7fbfa2;
      --accent-soft: #223028;
    }
  }
  :root[data-theme="dark"] {
    --bg: #14161a;
    --panel: #1c1f24;
    --ink: #eceeec;
    --muted: #9aa39c;
    --line: #303530;
    --accent: #7fbfa2;
    --accent-soft: #223028;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 16px;
  }

  .card {
    width: 100%;
    max-width: 920px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 36px 32px 32px;
  }

  h1 {
    margin: 0 0 6px;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  p.sub {
    margin: 0 0 10px;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  p.formula-note {
    margin: 0 0 28px;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .rules {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.82rem;
    color: var(--muted);
    background: var(--accent-soft);
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 26px;
    line-height: 1.7;
  }

  label {
    display: block;
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 5px;
  }

  .inputs-row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-bottom: 16px;
  }

  .field {
    margin-bottom: 0;
  }

  input[type="number"], input[type="text"] {
    width: 100%;
    padding: 10px 10px;
    font-size: 1.05rem;
    font-family: inherit;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    outline: none;
    transition: border-color 0.15s ease;
  }

  input[type="number"]:focus, input[type="text"]:focus {
    border-color: var(--accent);
  }

  .section {
    margin-bottom: 24px;
  }

  .section:last-child {
    margin-bottom: 0;
    margin-top: 24px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  h2 {
    margin: 0 0 14px;
    font-size: 1rem;
    color: var(--accent);
    font-weight: 600;
  }

  .eye-group {
    margin-bottom: 28px;
  }

  .tab-bar {
    display: flex;
    gap: 4px;
    margin-bottom: 20px;
    border-bottom: 2px solid var(--line);
  }

  .tab-button {
    font-family: inherit;
    font-size: 1rem;
    font-weight: 700;
    color: var(--muted);
    background: none;
    border: none;
    padding: 10px 18px;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .tab-button:hover {
    color: var(--ink);
  }

  .tab-button.active {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
  }

  h3 {
    margin: 0 0 14px;
    font-size: 1rem;
    color: var(--accent);
    font-weight: 600;
  }

  .results {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }

  .result {
    text-align: center;
    padding: 14px 8px;
    background: var(--accent-soft);
    border-radius: 10px;
