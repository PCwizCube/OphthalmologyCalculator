  .result .k {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 4px;
  }

  .result .v {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .note {
    margin-top: 18px;
    font-size: 0.8rem;
    color: var(--muted);
    text-align: center;
  }

  @media (max-width: 480px) {
